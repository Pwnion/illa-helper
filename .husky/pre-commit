#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit quality checks

echo "Running pre-commit checks..."

# Type-check the whole project
echo "Type-checking..."
npm run compile
if [ $? -ne 0 ]; then
  echo "Type check failed; commit blocked"
  exit 1
fi

# Format and lint staged files
echo "Formatting and linting staged files..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "Format or lint check failed; commit blocked"
  exit 1
fi
